# Copy this file to `.env` and fill in your own values. `.env` is gitignored —
# never commit real tokens.

# Create your own bot via Telegram's @BotFather (send it /newbot, follow the
# prompts). You'll get a token that looks like 123456789:AAExampleTokenHere.
TELEGRAM_BOT_TOKEN=

# Generate a long-lived OAuth token for headless Claude Code automation:
#   claude setup-token
# Run this on any machine where you're already logged into Claude Code with
# your Claude Pro or Max subscription. Usage from this project counts against
# your subscription's included usage, not per-token API billing.
CLAUDE_CODE_OAUTH_TOKEN=

# Host port the dashboard is published on (http://localhost:<this>). Change
# if 8090 is already taken by something else on your machine.
DASHBOARD_PORT=8090
